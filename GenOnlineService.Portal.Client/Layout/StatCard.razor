<BbCard Class="go-stat" data-testid="@TestId">
    <BbCardContent Class="bb:pt-6">
        @if (Href != null)
        {
            <a href="@Href" class="go-stat-link" aria-label="@Label"></a>
        }
        <div class="bb:flex bb:items-center bb:justify-between bb:gap-2">
            <p class="go-stat-label">@Label</p>
            <div class="go-stat-icon">
                <LucideIcon Name="@Icon" Class="bb:h-4 bb:w-4" />
            </div>
        </div>
        <div class="bb:mt-2">
            @if (Value == null)
            {
                <BbSkeleton Class="bb:h-8 bb:w-24" />
            }
            else
            {
                <p class="go-stat-value@(Attention ? " go-stat-value-attention" : "")">@Value</p>
            }
            <p class="bb:mt-1 bb:text-xs bb:text-muted-foreground">@Hint</p>
        </div>
    </BbCardContent>
</BbCard>

@code {
    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public string? Hint { get; set; }

    [Parameter]
    public string Icon { get; set; } = "activity";

    [Parameter]
    public bool Attention { get; set; }

    [Parameter]
    public string? Href { get; set; }

    [Parameter]
    public string? TestId { get; set; }
}
