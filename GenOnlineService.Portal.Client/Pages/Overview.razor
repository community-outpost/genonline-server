@page "/admin"
@inject PortalApi Api

<PageTitle>Overview · Generals Online</PageTitle>

<PageHeader Description="Generals Online right now: who is playing, what waits for staff, and the latest moderation.">
    <Title>Overview</Title>
    <Actions>
        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="LoadAsync" Loading="@m_loading" data-testid="refresh">
            <LucideIcon Name="refresh-cw" Class="bb:h-4 bb:w-4" />
            Refresh
        </BbButton>
        <BbButton Size="ButtonSize.Small" Href="@PortalRoutes.CasesPage">
            <LucideIcon Name="inbox" Class="bb:h-4 bb:w-4" />
            Open the review queue
        </BbButton>
    </Actions>
</PageHeader>

@if (m_error != null)
{
    <BbAlert Variant="AlertVariant.Danger">
        <Icon>
            <LucideIcon Name="circle-alert" Class="bb:h-4 bb:w-4" />
        </Icon>
        <ChildContent>
            <BbAlertTitle>The overview could not load</BbAlertTitle>
            <BbAlertDescription>@PortalText.Error(m_error)</BbAlertDescription>
        </ChildContent>
    </BbAlert>
}

<div class="go-stats">
    <StatCard Label="Players online" Value="@CountOf(o => o.PlayersOnline)" Icon="users" Hint="Connected to this service now" TestId="stat-players" />
    <StatCard Label="Lobbies open" Value="@CountOf(o => o.LobbiesOpen)" Icon="door-open" Hint="Waiting or in a match" TestId="stat-lobbies" />
    <StatCard Label="Matches today" Value="@CountOf(o => o.MatchesToday)" Icon="swords" Hint="Finished since 00:00 UTC" Href="@PortalRoutes.MatchesPage" TestId="stat-matches" />
    <StatCard Label="Players to review" Value="@CountOf(o => o.PlayersToReview)" Icon="inbox" Hint="Waiting in the review queue" Attention="@(m_overview?.PlayersToReview > 0)" Href="@PortalRoutes.CasesPage" TestId="stat-cases" />
</div>

<div class="go-dashboard">
    <BbCard>
        <BbCardHeader>
            <div class="bb:flex bb:items-center bb:justify-between bb:gap-2">
                <div class="bb:flex bb:items-center bb:gap-2">
                    <BbCardTitle As="h2">Next to review</BbCardTitle>
                    @if (m_overview?.PlayersToReview > 0)
                    {
                        <BbBadge Variant="BadgeVariant.Secondary">@PortalText.Count(m_overview.PlayersToReview) waiting</BbBadge>
                    }
                </div>
                <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" Href="@PortalRoutes.CasesPage">View all</BbButton>
            </div>
            <BbCardDescription>The players who have waited longest for a decision.</BbCardDescription>
        </BbCardHeader>
        <BbCardContent Class="bb:p-0">
            @if (m_overview == null)
            {
                <FeedSkeleton />
            }
            else if (m_overview.NextCases.Count == 0)
            {
                <BbEmpty Size="EmptySize.Small" Title="Nothing waits for a decision" Description="Every player case has been decided.">
                    <Icon>
                        <LucideIcon Name="inbox" />
                    </Icon>
                </BbEmpty>
            }
            else
            {
                <ul class="go-feed" data-testid="next-cases">
                    @foreach (PortalCaseRow row in m_overview.NextCases)
                    {
                        <li>
                            <a href="@PortalRoutes.PlayerCasePage(row.Player.Id)" class="go-feed-item">
                                <BbAvatar Class="bb:h-9 bb:w-9 bb:shrink-0">
                                    <BbAvatarFallback>@PortalText.Initials(row.Player.Name)</BbAvatarFallback>
                                </BbAvatar>
                                <div class="bb:flex-1 bb:min-w-0 bb:space-y-1">
                                    <div class="bb:flex bb:items-center bb:justify-between bb:gap-2">
                                        <p class="bb:text-sm bb:font-medium bb:leading-none bb:truncate">@row.Player.FullName</p>
                                        @if (row.ClaimedBy != null)
                                        {
                                            <span class="bb:text-xs bb:text-muted-foreground bb:shrink-0">claimed by @row.ClaimedBy.FullName</span>
                                        }
                                    </div>
                                    <div class="bb:flex bb:flex-wrap bb:gap-1">
                                        @foreach (KeyValuePair<string, int> waiting in row.Waiting)
                                        {
                                            <BbBadge Variant="BadgeVariant.Outline">@PortalCaseKinds.ShortTitle(waiting.Key) @PortalText.Count(waiting.Value)</BbBadge>
                                        }
                                    </div>
                                </div>
                            </a>
                        </li>
                    }
                </ul>
            }
        </BbCardContent>
    </BbCard>

    <BbCard>
        <BbCardHeader>
            <BbCardTitle As="h2">Recent sanctions</BbCardTitle>
            <BbCardDescription>The newest kicks, mutes and bans, by staff and by the service.</BbCardDescription>
        </BbCardHeader>
        <BbCardContent>
            @if (m_overview == null)
            {
                <FeedSkeleton />
            }
            else if (m_overview.RecentSanctions.Count == 0)
            {
                <BbEmpty Size="EmptySize.Small" Title="No sanctions" Description="Nobody has been kicked, muted or banned yet.">
                    <Icon>
                        <LucideIcon Name="gavel" />
                    </Icon>
                    <ChildContent>
                        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Href="@PortalRoutes.PlayersPage">Find a player</BbButton>
                    </ChildContent>
                </BbEmpty>
            }
            else
            {
                <BbTimeline Align="TimelineAlign.Left" Size="TimelineSize.Small" data-testid="recent-sanctions">
                    @for (int i = 0; i < m_overview.RecentSanctions.Count; i++)
                    {
                        PortalOverviewSanction sanction = m_overview.RecentSanctions[i];
                        <BbTimelineItem IconColor="TimelineColor.Secondary" ConnectorColor="TimelineColor.Muted"
                                        IconSize="TimelineSize.Small"
                                        ShowConnector="@(i < m_overview.RecentSanctions.Count - 1)">
                            <IconContent>
                                <LucideIcon Name="@PortalBadges.IconOfSanction(sanction.Type)" Class="bb:h-4 bb:w-4" />
                            </IconContent>
                            <ChildContent>
                                <BbTimelineContent>
                                    <BbTimelineHeader>
                                        <BbTimelineTitle As="div" Class="bb:text-sm">
                                            <span class="go-capitalize">@sanction.Type</span> for
                                            <BbLink Href="@PortalRoutes.PlayerPage(sanction.Player.Id)">@sanction.Player.FullName</BbLink>
                                        </BbTimelineTitle>
                                    </BbTimelineHeader>
                                    <BbTimelineDescription Class="bb:text-xs">
                                        @(sanction.CreatedBy?.FullName ?? "the service") · @PortalText.Ago(sanction.CreatedAt, m_now)@(sanction.Reason != null ? " · " + sanction.Reason : "")
                                        @if (sanction.Active)
                                        {
                                            <BbBadge Variant="BadgeVariant.SoftDestructive" Class="bb:ms-1">active</BbBadge>
                                        }
                                    </BbTimelineDescription>
                                </BbTimelineContent>
                            </ChildContent>
                        </BbTimelineItem>
                    }
                </BbTimeline>
            }
        </BbCardContent>
    </BbCard>

    <BbCard>
        <BbCardHeader>
            <BbCardTitle As="h2">Waiting by kind</BbCardTitle>
            <BbCardDescription>Signals waiting for a decision, per kind.</BbCardDescription>
        </BbCardHeader>
        <BbCardContent>
            @if (m_overview == null)
            {
                <FeedSkeleton />
            }
            else
            {
                <div class="go-list" data-testid="queues">
                    @foreach (PortalQueue queue in m_overview.Waiting)
                    {
                        <a href="@(PortalRoutes.CasesPage + "?kind=" + queue.Kind)" class="go-list-item">
                            <LucideIcon Name="@PortalCaseKinds.Icon(queue.Kind)" Class="bb:h-4 bb:w-4 bb:text-muted-foreground" />
                            <span class="bb:flex-1 bb:text-sm">@PortalCaseKinds.Title(queue.Kind)</span>
                            <BbBadge Variant="@(queue.Waiting > 0 ? BadgeVariant.Soft : BadgeVariant.Outline)" Class="go-count">@PortalText.Count(queue.Waiting)</BbBadge>
                        </a>
                    }
                </div>
            }
        </BbCardContent>
    </BbCard>

    <BbCard>
        <BbCardHeader>
            <BbCardTitle As="h2">Quick links</BbCardTitle>
            <BbCardDescription>Jump straight to a staff tool.</BbCardDescription>
        </BbCardHeader>
        <BbCardContent>
            <div class="go-list">
                <a href="@PortalRoutes.PlayersPage" class="go-list-item">
                    <LucideIcon Name="search" Class="bb:h-4 bb:w-4 bb:text-muted-foreground" />
                    <span class="bb:flex-1 bb:text-sm">Find a player by name or id</span>
                    <LucideIcon Name="chevron-right" Class="bb:h-4 bb:w-4 bb:text-muted-foreground" />
                </a>
                <a href="@PortalRoutes.CasesPage" class="go-list-item">
                    <LucideIcon Name="inbox" Class="bb:h-4 bb:w-4 bb:text-muted-foreground" />
                    <span class="bb:flex-1 bb:text-sm">Work through the review queue</span>
                    <LucideIcon Name="chevron-right" Class="bb:h-4 bb:w-4 bb:text-muted-foreground" />
                </a>
                <a href="@PortalRoutes.MatchesPage" class="go-list-item">
                    <LucideIcon Name="swords" Class="bb:h-4 bb:w-4 bb:text-muted-foreground" />
                    <span class="bb:flex-1 bb:text-sm">Look up a match by its id</span>
                    <LucideIcon Name="chevron-right" Class="bb:h-4 bb:w-4 bb:text-muted-foreground" />
                </a>
                <a href="@PortalRoutes.AccountPage" class="go-list-item">
                    <LucideIcon Name="user" Class="bb:h-4 bb:w-4 bb:text-muted-foreground" />
                    <span class="bb:flex-1 bb:text-sm">Your own profile and two-factor sign-in</span>
                    <LucideIcon Name="chevron-right" Class="bb:h-4 bb:w-4 bb:text-muted-foreground" />
                </a>
            </div>
        </BbCardContent>
    </BbCard>
</div>

@code {
    [CascadingParameter]
    public PortalLayout? Shell { get; set; }

    private PortalOverview? m_overview;
    private string? m_error;
    private bool m_loading;
    private DateTime m_now = DateTime.UtcNow;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        m_loading = true;
        PortalAnswer<PortalOverview> answer = await Api.GetOverviewAsync();
        m_loading = false;
        m_now = DateTime.UtcNow;
        m_error = answer.Ok ? null : answer.Error;
        if (answer.Value != null)
        {
            m_overview = answer.Value;
            if (Shell != null)
            {
                await Shell.RefreshCountsAsync(m_overview);
            }
        }
    }

    private string? CountOf(Func<PortalOverview, int> pick) => m_overview == null ? (m_error != null ? "?" : null) : PortalText.Count(pick(m_overview));
}
